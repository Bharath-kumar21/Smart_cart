# SmartCart Environment Variables Configuration
# Copy this file to .env and fill in your values for production

SECRET_KEY=your_secure_secret_key_here

# Database Configuration (MySQL)
# On PythonAnywhere:
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_USER=yourusername
# DB_PASSWORD=your_mysql_password
# DB_NAME=yourusername$smartcart
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=abcd
DB_NAME=smartcart

# Email SMTP Settings (Gmail App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
